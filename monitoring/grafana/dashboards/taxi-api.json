{
  "uid": "taxi-api",
  "title": "Green Taxi API",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "mlops"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / s by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(taxi_api_http_requests_total{path=\"/predict\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Prediction latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taxi_api_http_request_duration_seconds_bucket{path=\"/predict\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(taxi_api_http_request_duration_seconds_bucket{path=\"/predict\"}[1m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Mean predicted duration (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(taxi_api_predicted_duration_minutes_sum[5m])) / sum(rate(taxi_api_predicted_duration_minutes_count[5m]))",
          "legendFormat": "mean prediction"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Mean trip_distance in requests (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthmi"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(taxi_api_trip_distance_miles_sum[5m])) / sum(rate(taxi_api_trip_distance_miles_count[5m]))",
          "legendFormat": "mean distance"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total predictions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(taxi_api_http_requests_total{path=\"/predict\",status=\"200\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Rejected requests (4xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(taxi_api_http_requests_total{path=\"/predict\",status=~\"4..\"}) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Predicted duration distribution",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (taxi_api_predicted_duration_minutes_bucket)",
          "legendFormat": "≤ {{le}} min",
          "format": "heatmap"
        }
      ]
    }
  ]
}